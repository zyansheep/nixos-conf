 namespace waybar {
 
+static void fillPowerMenuProcesses(GtkWidget* box) {
+  GList* old = gtk_container_get_children(GTK_CONTAINER(box));
+  for (GList* child = old; child; child = child->next) gtk_widget_destroy(GTK_WIDGET(child->data));
+  g_list_free(old);
+  const auto snapshot =
+      std::filesystem::path(g_get_user_runtime_dir()) / "waybar-monitor" / "snapshot.json";
+  const auto battery = powerMenuBattery(snapshot, g_get_real_time() / 1e6);
+  auto* title = gtk_label_new(battery.title.empty() ? "Battery use: waiting for the system monitor…"
+                                                    : battery.title.c_str());
+  gtk_label_set_xalign(GTK_LABEL(title), 0);
+  gtk_style_context_add_class(gtk_widget_get_style_context(title), "battery-processes-title");
+  gtk_box_pack_start(GTK_BOX(box), title, FALSE, FALSE, 0);
+  auto add = [box](const std::string& name, const std::string& value, bool part) {
+    auto* line = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 12);
+    auto* label = gtk_label_new(name.c_str());
+    gtk_label_set_xalign(GTK_LABEL(label), 0);
+    gtk_label_set_ellipsize(GTK_LABEL(label), PANGO_ELLIPSIZE_END);
+    gtk_label_set_max_width_chars(GTK_LABEL(label), 24);
+    auto* amount = gtk_label_new(value.c_str());
+    gtk_style_context_add_class(gtk_widget_get_style_context(amount), "battery-process-value");
+    if (part) gtk_style_context_add_class(gtk_widget_get_style_context(line), "battery-process-part");
+    gtk_box_pack_start(GTK_BOX(line), label, TRUE, TRUE, 0);
+    gtk_box_pack_end(GTK_BOX(line), amount, FALSE, FALSE, 0);
+    gtk_box_pack_start(GTK_BOX(box), line, FALSE, FALSE, 0);
+  };
+  for (const auto& row : battery.rows) {
+    add(row.name, row.value, false);
+    for (const auto& [name, value] : row.parts) add(name, value, true);  // The idle chip's rails.
+  }
+  if (!battery.footer.empty()) {
+    auto* footer = gtk_label_new(battery.footer.c_str());
+    gtk_label_set_xalign(GTK_LABEL(footer), 0);
+    gtk_style_context_add_class(gtk_widget_get_style_context(footer), "battery-processes-footer");
+    gtk_box_pack_start(GTK_BOX(box), footer, FALSE, FALSE, 0);
+  }
+  gtk_widget_show_all(box);
+}
+
+static std::filesystem::path powerMenuEtaPath() {
+  return std::filesystem::path(g_get_user_runtime_dir()) / "waybar-monitor" / "eta.json";
+}
+
+static PowerMenuModes currentPowerMenuModes() {
+  return powerMenuModes(std::filesystem::path(g_get_user_state_dir()) / "waybar-monitor",
+                        std::filesystem::path(g_get_user_runtime_dir()) / "waybar-monitor",
+                        g_get_real_time() / 1e6);
+}
+
+// A mode row's column: the main line, and a small faded one under it.
+static std::string powerMenuMarkup(const std::string& main, const std::string& detail,
+                                   const std::string& prefix = "") {
+  auto escape = [](const std::string& text) {
+    auto* escaped = g_markup_escape_text(text.c_str(), -1);
+    std::string result = escaped;
+    g_free(escaped);
+    return result;
+  };
+  std::string markup = escape(main);
+  if (!detail.empty()) markup += "\n<span size='small' alpha='60%'>" + prefix + escape(detail) + "</span>";
+  return markup;
+}
+
+static GtkWidget* findPowerMenuWidget(GtkWidget* widget, const char* name) {
+  if (g_strcmp0(gtk_widget_get_name(widget), name) == 0) return widget;
+  GtkWidget* found = nullptr;
+  if (GTK_IS_CONTAINER(widget)) {
+    GList* children = gtk_container_get_children(GTK_CONTAINER(widget));
+    for (GList* child = children; child && !found; child = child->next)
+      found = findPowerMenuWidget(GTK_WIDGET(child->data), name);
+    g_list_free(children);
+  }
+  return found;
+}
+
+static void showPowerMenuModes(GtkWidget* menu, const PowerMenuModes& modes) {
+  if (auto* toggle = findPowerMenuWidget(menu, "battery-experiments-switch"); GTK_IS_SWITCH(toggle))
+    gtk_switch_set_active(GTK_SWITCH(toggle), modes.experiments);
+  if (auto* toggle = findPowerMenuWidget(menu, "battery-comfort-switch"); GTK_IS_SWITCH(toggle))
+    gtk_switch_set_active(GTK_SWITCH(toggle), modes.comfort);
+  auto line = [&](const char* name, const std::string& text) {
+    auto* label = findPowerMenuWidget(menu, name);
+    if (!GTK_IS_LABEL(label)) return;
+    gtk_label_set_text(GTK_LABEL(label), text.c_str());
+    gtk_widget_set_no_show_all(label, TRUE);
+    gtk_widget_set_visible(label, !text.empty());
+  };
+  line("battery-experiments-status", modes.status);
+  // goal --apply applies nothing while a run owns the settings, and disable restores stock.
+  line("battery-modes-note", !modes.experiments ? ""
+                             : modes.settled ? "Testing is paused: switching sets the goal's combination"
+                                             : "While experiments run, this only sets the goal");
+  for (const std::string goal : {"battery", "comfort"}) {
+    auto* row = findPowerMenuWidget(menu, ("battery-mode-" + goal).c_str());
+    auto* change = findPowerMenuWidget(menu, ("battery-mode-" + goal + "-change").c_str());
+    auto* gain = findPowerMenuWidget(menu, ("battery-mode-" + goal + "-gain").c_str());
+    if (row == nullptr || !GTK_IS_LABEL(change) || !GTK_IS_LABEL(gain)) continue;
+    auto* style = gtk_widget_get_style_context(row);
+    ((goal == "comfort") == modes.comfort ? gtk_style_context_add_class
+                                          : gtk_style_context_remove_class)(style, "active");
+    const auto best = modes.best.find(goal);
+    if (best == modes.best.end()) {
+      gtk_label_set_markup(GTK_LABEL(change), powerMenuMarkup("waiting for battery-eta…", "").c_str());
+      gtk_label_set_text(GTK_LABEL(gain), "");
+      continue;
+    }
+    gtk_label_set_markup(GTK_LABEL(change),
+                         powerMenuMarkup(best->second.change, best->second.delight,
+                                         "<span font_family='Font Awesome 7 Free' weight='900'></span> ")
+                             .c_str());
+    gtk_label_set_markup(GTK_LABEL(gain), powerMenuMarkup(best->second.gain, best->second.interval).c_str());
+  }
+}
+
+// battery-eta's lines: the time left (to the second in its last minutes) and
+// asleep from now.
+static void showPowerMenuEta(GtkWidget* menu) {
+  const auto eta = powerMenuEta(powerMenuEtaPath(), g_get_real_time() / 1e6);
+  auto set = [](GtkWidget* label, const std::string& text) {
+    if (g_strcmp0(gtk_label_get_text(GTK_LABEL(label)), text.c_str()) != 0)  // No relayout for nothing.
+      gtk_label_set_text(GTK_LABEL(label), text.c_str());
+  };
+  if (auto* title = findPowerMenuWidget(menu, "battery-eta-title"); GTK_IS_LABEL(title))
+    set(title, eta.title.empty() ? "Time left: waiting for battery-eta…" : eta.title);
+  if (auto* asleep = findPowerMenuWidget(menu, "battery-eta-sleep"); GTK_IS_LABEL(asleep)) {
+    set(asleep, eta.sleep);
+    gtk_widget_set_no_show_all(asleep, TRUE);
+    gtk_widget_set_visible(asleep, !eta.sleep.empty());
+  }
+}
+
+// While the menu is open, its battery-eta lines tick every second (they would
+// otherwise freeze mid-countdown); the timer ends once the menu is unmapped.
+static gboolean tickPowerMenuEta(gpointer data) {
+  auto* menu = GTK_WIDGET(data);
+  if (!gtk_widget_get_mapped(menu)) return G_SOURCE_REMOVE;
+  try {
+    showPowerMenuEta(menu);
+  } catch (const std::exception& error) {  // jsoncpp type errors must not end Waybar.
+    spdlog::warn("battery menu: {}", error.what());
+  }
+  return G_SOURCE_CONTINUE;
+}
+
+static void startPowerMenuTick(GtkWidget* menu) {
+  if (g_object_get_data(G_OBJECT(menu), "power-menu-tick") != nullptr) return;
+  g_object_set_data(G_OBJECT(menu), "power-menu-tick", GINT_TO_POINTER(1));
+  g_timeout_add_full(G_PRIORITY_DEFAULT, 1000, tickPowerMenuEta, g_object_ref(menu), +[](gpointer data) {
+    g_object_set_data(G_OBJECT(data), "power-menu-tick", nullptr);
+    g_object_unref(data);
+  });
+}
+
+// battery-experiments and battery-comfort: a click flips the row's switch and
+// runs power-experiment, keeping the menu open (Enter does the same and closes
+// it). The menu item's input window covers the switch, so the item gets every
+// click.
+static void togglePowerMenuRow(GtkWidget* item) {
+  auto* menu = gtk_widget_get_parent(item);
+  const bool experiments = g_strcmp0(gtk_widget_get_name(item), "battery-experiments") == 0;
+  auto* toggle = findPowerMenuWidget(item, experiments ? "battery-experiments-switch" : "battery-comfort-switch");
+  if (!GTK_IS_SWITCH(toggle) || menu == nullptr) return;
+  const bool on = !gtk_switch_get_active(GTK_SWITCH(toggle));
+  const std::string command = std::string("/run/current-system/sw/bin/power-experiment ") +
+                              (experiments ? (on ? "enable" : "disable")
+                                           : (on ? "goal comfort --apply" : "goal battery --apply"));
+  GError* error = nullptr;
+  if (!g_spawn_command_line_async(command.c_str(), &error)) {
+    spdlog::warn("battery menu: {}: {}", command, error->message);
+    g_error_free(error);
+    return;
+  }
+  auto modes = currentPowerMenuModes();  // The command may not have written anything yet.
+  if (experiments) {
+    modes.experiments = on;
+    modes.status = on ? "Starting…" : "";
+  } else {
+    modes.comfort = on;
+  }
+  showPowerMenuModes(menu, modes);
+}
+
+// The menu item a button-1 press in the menu began on: a row flips only on a
+// release that ends a press on that same row, never on the release that ends
+// a press-drag from the bar (GTK delivers it to the item under the pointer).
+static gboolean pressPowerMenu(GtkWidget* menu, GdkEventButton* event, gpointer) {
+  GtkWidget* item = gtk_get_event_widget(reinterpret_cast<GdkEvent*>(event));
+  while (item != nullptr && !GTK_IS_MENU_ITEM(item)) item = gtk_widget_get_parent(item);
+  g_object_set_data(G_OBJECT(menu), "power-menu-pressed", event->button == 1 ? item : nullptr);
+  return FALSE;
+}
+
+static gboolean releasePowerMenuRow(GtkWidget* item, GdkEventButton* event, gpointer) {
+  auto* menu = gtk_widget_get_parent(item);
+  if (event->button != 1 || !GTK_IS_MENU_SHELL(menu)) return FALSE;
+  const bool clicked = g_object_get_data(G_OBJECT(menu), "power-menu-pressed") == item &&
+                       gtk_menu_shell_get_selected_item(GTK_MENU_SHELL(menu)) == item;
+  g_object_set_data(G_OBJECT(menu), "power-menu-pressed", nullptr);
+  try {
+    if (clicked) togglePowerMenuRow(item);
+  } catch (const std::exception& error) {  // jsoncpp type errors must not end Waybar.
+    spdlog::warn("battery menu: {}", error.what());
+  }
+  return TRUE;  // Never the menu's own activation on release: that is Enter's alone.
+}
+
 static void updatePowerMenuStats(GtkWidget* widget) {
+  if (GTK_IS_MENU(widget) && findPowerMenuWidget(widget, "battery-experiments") != nullptr) {
+    showPowerMenuModes(widget, currentPowerMenuModes());
+    if (g_object_get_data(G_OBJECT(widget), "power-menu-press") == nullptr) {
+      g_signal_connect(widget, "button-press-event", G_CALLBACK(pressPowerMenu), nullptr);
+      g_signal_connect(widget, "unmap", G_CALLBACK(+[](GtkWidget* menu, gpointer) {
+                         g_object_set_data(G_OBJECT(menu), "power-menu-pressed", nullptr);
+                       }), nullptr);
+      g_object_set_data(G_OBJECT(widget), "power-menu-press", GINT_TO_POINTER(1));
+    }
+  }
+  if (GTK_IS_MENU(widget) && findPowerMenuWidget(widget, "battery-eta-title") != nullptr) {
+    showPowerMenuEta(widget);
+    startPowerMenuTick(widget);
+  }
   if (GTK_IS_LABEL(widget) && g_strcmp0(gtk_widget_get_name(widget), "battery-stats") == 0) {
     gtk_label_set_text(GTK_LABEL(widget), powerMenuStats().c_str());
+  } else if (GTK_IS_BOX(widget) && g_strcmp0(gtk_widget_get_name(widget), "battery-processes") == 0) {
+    fillPowerMenuProcesses(widget);
+  } else if (GTK_IS_MENU_ITEM(widget) && (g_strcmp0(gtk_widget_get_name(widget), "battery-experiments") == 0 ||
+                                          g_strcmp0(gtk_widget_get_name(widget), "battery-comfort") == 0)) {
+    if (g_object_get_data(G_OBJECT(widget), "power-menu-row") == nullptr) {
+      g_signal_connect(widget, "button-release-event", G_CALLBACK(releasePowerMenuRow), nullptr);
+      g_signal_connect(widget, "activate", G_CALLBACK(+[](GtkMenuItem* item, gpointer) {
+                         try {
+                           togglePowerMenuRow(GTK_WIDGET(item));
+                         } catch (const std::exception& error) {
+                           spdlog::warn("battery menu: {}", error.what());
+                         }
+                       }), nullptr);
+      g_object_set_data(G_OBJECT(widget), "power-menu-row", GINT_TO_POINTER(1));
+    }
   } else if (GTK_IS_CONTAINER(widget)) {
     GList* children = gtk_container_get_children(GTK_CONTAINER(widget));
     for (GList* child = children; child; child = child->next)
