 namespace waybar {
 
+// The battery panel's colours (drainhound's Trail), for the menu's charts.
+static void powerMenuSource(cairo_t* cr, const std::string& hex, double alpha = 1.0) {
+  const auto channel = [&](size_t i) { return std::stoi(hex.substr(i, 2), nullptr, 16) / 255.0; };
+  cairo_set_source_rgba(cr, channel(1), channel(3), channel(5), alpha);
+}
+
+static void powerMenuRounded(cairo_t* cr, double x, double y, double w, double h, double r) {
+  r = std::min({r, w / 2, h / 2});
+  cairo_new_sub_path(cr);
+  cairo_arc(cr, x + w - r, y + r, r, -G_PI / 2, 0);
+  cairo_arc(cr, x + w - r, y + h - r, r, 0, G_PI / 2);
+  cairo_arc(cr, x + r, y + h - r, r, G_PI / 2, G_PI);
+  cairo_arc(cr, x + r, y + r, r, G_PI, 3 * G_PI / 2);
+  cairo_close_path(cr);
+}
+
+// Text on a menu chart with its top at y and its left (or, `right`, its right) end
+// at x; `halo` rings it in the menu's background so it reads over the runs.
+static void powerMenuText(cairo_t* cr, const std::string& text, double x, double y, double size,
+                          const std::string& color, bool bold = false, bool right = false, bool halo = false) {
+  PangoLayout* layout = pango_cairo_create_layout(cr);
+  PangoFontDescription* font = pango_font_description_from_string("DejaVu Sans");
+  pango_font_description_set_absolute_size(font, size * PANGO_SCALE);
+  if (bold) pango_font_description_set_weight(font, PANGO_WEIGHT_BOLD);
+  pango_layout_set_font_description(layout, font);
+  pango_layout_set_text(layout, text.c_str(), -1);
+  int w = 0, h = 0;
+  pango_layout_get_pixel_size(layout, &w, &h);
+  if (right) x -= w;
+  if (halo) {
+    cairo_move_to(cr, x, y);
+    pango_cairo_layout_path(cr, layout);
+    powerMenuSource(cr, "#303236");
+    cairo_set_line_width(cr, 3);
+    cairo_set_line_join(cr, CAIRO_LINE_JOIN_ROUND);
+    cairo_stroke(cr);
+  }
+  powerMenuSource(cr, color);
+  cairo_move_to(cr, x, y);
+  pango_cairo_show_layout(cr, layout);
+  pango_font_description_free(font);
+  g_object_unref(layout);
+}
+
+// The battery-use rows' watts as one bar, each in the colour the panel's stack gives it.
+static gboolean drawPowerMenuShares(GtkWidget* widget, cairo_t* cr, gpointer) {
+  using Shares = std::vector<std::pair<double, std::string>>;
+  const auto* shares = static_cast<Shares*>(g_object_get_data(G_OBJECT(widget), "power-menu-shares"));
+  if (shares == nullptr) return FALSE;
+  double total = 0;
+  for (const auto& [watts, _] : *shares) total += watts;
+  if (total <= 0) return FALSE;
+  const double width = gtk_widget_get_allocated_width(widget), height = gtk_widget_get_allocated_height(widget);
+  double x = 0;
+  for (const auto& [watts, color] : *shares) {
+    const double w = watts / total * width;
+    powerMenuRounded(cr, x, 0, std::max(0.0, w - 1), height, 1.5);
+    powerMenuSource(cr, color);
+    cairo_fill(cr);
+    x += w;
+  }
+  return FALSE;
+}
