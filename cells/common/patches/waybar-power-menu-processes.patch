+// A mode row's column: the main line, and a small faded one under it.
+static std::string powerMenuMarkup(const std::string& main, const std::string& detail,
+                                   const std::string& prefix = "") {
+  auto escape = [](const std::string& text) {
+    auto* escaped = g_markup_escape_text(text.c_str(), -1);
+    std::string result = escaped;
+    g_free(escaped);
+    return result;
+  };
+  std::string markup = escape(main);
+  if (!detail.empty()) markup += "\n<span size='small' alpha='60%'>" + prefix + escape(detail) + "</span>";
+  return markup;
+}
+
+static GtkWidget* findPowerMenuWidget(GtkWidget* widget, const char* name) {
+  if (g_strcmp0(gtk_widget_get_name(widget), name) == 0) return widget;
+  GtkWidget* found = nullptr;
+  if (GTK_IS_CONTAINER(widget)) {
+    GList* children = gtk_container_get_children(GTK_CONTAINER(widget));
+    for (GList* child = children; child && !found; child = child->next)
+      found = findPowerMenuWidget(GTK_WIDGET(child->data), name);
+    g_list_free(children);
+  }
+  return found;
+}
+
+static void showPowerMenuModes(GtkWidget* menu, const PowerMenuModes& modes) {
+  if (auto* toggle = findPowerMenuWidget(menu, "battery-experiments-switch"); GTK_IS_SWITCH(toggle))
+    gtk_switch_set_active(GTK_SWITCH(toggle), modes.experiments);
+  if (auto* toggle = findPowerMenuWidget(menu, "battery-comfort-switch"); GTK_IS_SWITCH(toggle))
+    gtk_switch_set_active(GTK_SWITCH(toggle), modes.comfort);
+  auto line = [&](const char* name, const std::string& text) {
+    auto* label = findPowerMenuWidget(menu, name);
+    if (!GTK_IS_LABEL(label)) return;
+    gtk_label_set_text(GTK_LABEL(label), text.c_str());
+    gtk_widget_set_no_show_all(label, TRUE);
+    gtk_widget_set_visible(label, !text.empty());
+  };
+  line("battery-experiments-status", modes.status);
+  // goal --apply applies nothing while a run owns the settings, and disable restores stock.
+  line("battery-modes-note", !modes.experiments ? ""
+                             : modes.settled ? "Testing is paused: switching sets the goal's combination"
+                                             : "While experiments run, this only sets the goal");
+  for (const std::string goal : {"battery", "comfort"}) {
+    auto* row = findPowerMenuWidget(menu, ("battery-mode-" + goal).c_str());
+    auto* change = findPowerMenuWidget(menu, ("battery-mode-" + goal + "-change").c_str());
+    auto* gain = findPowerMenuWidget(menu, ("battery-mode-" + goal + "-gain").c_str());
+    if (row == nullptr || !GTK_IS_LABEL(change) || !GTK_IS_LABEL(gain)) continue;
+    auto* style = gtk_widget_get_style_context(row);
+    ((goal == "comfort") == modes.comfort ? gtk_style_context_add_class
+                                          : gtk_style_context_remove_class)(style, "active");
+    const auto best = modes.best.find(goal);
+    if (best == modes.best.end()) {
+      gtk_label_set_markup(GTK_LABEL(change), powerMenuMarkup("waiting for drainhound…", "").c_str());
+      gtk_label_set_text(GTK_LABEL(gain), "");
+      continue;
+    }
+    gtk_label_set_markup(GTK_LABEL(change),
+                         powerMenuMarkup(best->second.change, best->second.delight,
+                                         "<span font_family='Font Awesome 7 Free' weight='900'></span> ")
+                             .c_str());
+    gtk_label_set_markup(GTK_LABEL(gain), powerMenuMarkup(best->second.gain, best->second.interval).c_str());
+  }
+}
