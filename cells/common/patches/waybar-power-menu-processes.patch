+static void fillPowerMenuProcesses(GtkWidget* box) {
+  GList* old = gtk_container_get_children(GTK_CONTAINER(box));
+  for (GList* child = old; child; child = child->next) gtk_widget_destroy(GTK_WIDGET(child->data));
+  g_list_free(old);
+  const auto snapshot =
+      std::filesystem::path(g_get_user_runtime_dir()) / "drainhound" / "snapshot.json";
+  const auto battery = powerMenuBattery(snapshot, g_get_real_time() / 1e6);
+  auto* title = gtk_label_new(battery.title.empty() ? "Battery use: waiting for the system monitor…"
+                                                    : battery.title.c_str());
+  gtk_label_set_xalign(GTK_LABEL(title), 0);
+  gtk_style_context_add_class(gtk_widget_get_style_context(title), "battery-processes-title");
+  gtk_box_pack_start(GTK_BOX(box), title, FALSE, FALSE, 0);
+  if (!battery.rows.empty()) {
+    auto* bar = gtk_drawing_area_new();
+    gtk_widget_set_size_request(bar, 348, 10);
+    gtk_widget_set_margin_bottom(bar, 3);
+    auto* shares = new std::vector<std::pair<double, std::string>>();
+    for (const auto& row : battery.rows) shares->emplace_back(powerMenuWatts(row.value), powerMenuUseColor(row.name));
+    g_object_set_data_full(G_OBJECT(bar), "power-menu-shares", shares, +[](gpointer data) {
+      delete static_cast<std::vector<std::pair<double, std::string>>*>(data);
+    });
+    g_signal_connect(bar, "draw", G_CALLBACK(drawPowerMenuShares), nullptr);
+    gtk_box_pack_start(GTK_BOX(box), bar, FALSE, FALSE, 0);
+  }
+  auto add = [box](const std::string& name, const std::string& value, bool part) {
+    auto* line = gtk_box_new(GTK_ORIENTATION_HORIZONTAL, 12);
+    auto* label = gtk_label_new(name.c_str());
+    gtk_label_set_xalign(GTK_LABEL(label), 0);
+    gtk_label_set_ellipsize(GTK_LABEL(label), PANGO_ELLIPSIZE_END);
+    gtk_label_set_max_width_chars(GTK_LABEL(label), 24);
+    auto* amount = gtk_label_new(value.c_str());
+    gtk_style_context_add_class(gtk_widget_get_style_context(amount), "battery-process-value");
+    if (part) gtk_style_context_add_class(gtk_widget_get_style_context(line), "battery-process-part");
+    gtk_box_pack_start(GTK_BOX(line), label, TRUE, TRUE, 0);
+    gtk_box_pack_end(GTK_BOX(line), amount, FALSE, FALSE, 0);
+    gtk_box_pack_start(GTK_BOX(box), line, FALSE, FALSE, 0);
+  };
+  for (const auto& row : battery.rows) {
+    add(row.name, row.value, false);
+    for (const auto& [name, value] : row.parts) add(name, value, true);  // The idle chip's rails.
+  }
+  if (!battery.footer.empty()) {
+    auto* footer = gtk_label_new(battery.footer.c_str());
+    gtk_label_set_xalign(GTK_LABEL(footer), 0);
+    gtk_style_context_add_class(gtk_widget_get_style_context(footer), "battery-processes-footer");
+    gtk_box_pack_start(GTK_BOX(box), footer, FALSE, FALSE, 0);
+  }
+  gtk_widget_show_all(box);
+}
