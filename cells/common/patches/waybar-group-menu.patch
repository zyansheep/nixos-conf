+// Mirror only our namespaced classes; preserve the target widget's own styling.
+void AModule::mirrorStyleClasses(const Glib::RefPtr<Gtk::StyleContext>& source,
+                                const Glib::RefPtr<Gtk::StyleContext>& target,
+                                const Glib::ustring& prefix) {
+  for (const auto& name : target->list_classes()) {
+    if (name.compare(0, prefix.size(), prefix) == 0 &&
+        !source->has_class(name.substr(prefix.size()))) {
+      target->remove_class(name);
+    }
+  }
+  for (const auto& name : source->list_classes()) {
+    if (!target->has_class(prefix + name)) target->add_class(prefix + name);
   }
 }

