// -*- mode: jsonc -*-
{
  // Use "gauges-arc" for open dials; "gauges-ring" for full circles.
  "name": "gauges-ring",
  // "layer": "top", // Waybar at top layer
  // "position": "bottom", // Waybar position (top|bottom|left|right)
  "height": 20, // Waybar height (to be removed for auto height)
  // "width": 1280, // Waybar width
  "spacing": 0, // Gaps between modules (4px)
  // Choose the order of the modules
  "modules-left": [
    "niri/workspaces",
    "custom/media",
    "niri/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/recording",
    "mpd",
    "group/tray-group",
    "idle_inhibitor",
    "group/network",
    "cpu",
    "memory",
    "temperature",
    // "backlight",
    "custom/services",
    "group/power",
    "custom/notification",
    // "battery#bat2",
    "pulseaudio",
    "custom/power"
  ],
  "group/tray-group": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 300,
      "children-class": "tray-drawer-child",
      "transition-left-to-right": false
    },
    "modules": [ "custom/tray-toggle", "tray" ]
  },
  "custom/tray-toggle": {
    "format": "",
    "tooltip": true,
    "tooltip-format": "System tray (hover to expand)"
  },
  "group/network": {
    "orientation": "horizontal",
    "modules": [ "network", "network#signal" ]
  },
  "group/power": {
    "orientation": "horizontal",
    "modules": [ "battery", "power-profiles-daemon" ]
  },
  "custom/services": {
    "exec": "$HOME/.config/waybar/scripts/svc-status.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "eww open --toggle services-popup"
  },
  "custom/notification": {
    "tooltip": true,
    "format": "{icon} {text}",
    "format-icons": {
      "notification": "󱅫",
      "none": "󰂜",
      "dnd-notification": "󰂠",
      "dnd-none": "󰪓",
      "inhibited-notification": "󰂛",
      "inhibited-none": "󰪑",
      "dnd-inhibited-notification": "󰂠",
      "dnd-inhibited-none": "󰪓"
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    // Blank the count while DND is active so only the bell icon shows.
    "exec": "swaync-client -swb | jq --unbuffered -c 'if (.class // \"\" | test(\"dnd\")) then .text=\"\" else . end'",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true
  },
  "custom/recording": {
    "exec": "$HOME/.config/waybar/scripts/wf-rec-notif.sh",
    "exec-on-event": false,
    "on-click": "pkill -INT wf-recorder", // Click to stop recording
    "return-type": "json",
    "tooltip": true,
    "format": "{}",
    "interval": 1 // How often to check the script (in seconds)
  },
  "niri/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "web": "󰖟",
      "notes": "󰠮",
      "dev": "",
      "chat": "󰭹",
      "monitors": "",
      "default": ""
    }
  },
  "niri/window": {
    "format": "{title}",
    "icon": true,
    "icon-size": 16,
    "max-length": 50
  },
  "mpd": {
    "format": "{stateIcon} {consumeIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - {album} - {title} ({elapsedTime:%M:%S}/{totalTime:%M:%S}) ⸨{songPosition}|{queueLength}⸩ {volume}% ",
    "format-disconnected": "Disconnected ",
    "format-stopped": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
    "unknown-tag": "N/A",
    "interval": 5,
    "consume-icons": {
      "on": " "
    },
    "random-icons": {
      "off": "<span color=\"#f53c3c\"></span> ",
      "on": " "
    },
    "repeat-icons": {
      "on": " "
    },
    "single-icons": {
      "on": "1 "
    },
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    "tooltip-format": "MPD (connected)",
    "tooltip-format-disconnected": "MPD (disconnected)"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "",
      "deactivated": ""
    },
    "tooltip-format-activated": "Idle inhibitor: ON (screen wont sleep)",
    "tooltip-format-deactivated": "Idle inhibitor: OFF (click to keep screen awake)"
  },
  "tray": {
    // "icon-size": 21,
    "spacing": 10
  },
  "clock": {
    "format": "{:%A %B %d, 1%Y %H:%M:%S}",
    "interval": 1,
    // "format-alt": "{:%A, %B %d, %Y (%R)}  ",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "year",
      "mode-mon-col": 3,
      "weeks-pos": "right",
      "on-scroll": 1,
      "on-click-right": "mode",
      "format": {
        "months": "<span color='#ffead3'><b>{}</b></span>",
        "days": "<span color='#ecc6d9'><b>{}</b></span>",
        "weeks": "<span color='#99ffdd'><b>W{}</b></span>",
        "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
        "today": "<span color='#ff6699'><b><u>{}</u></b></span>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-click-forward": "tz_up",
      "on-click-backward": "tz_down",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "cpu": {
    "format": "",
    "format-alt": "<span font_family='DejaVu Sans' weight='normal' size='small'>{usage}</span>",
    "format-alt-click": 1,
    "tooltip": true,
    "interval": 2,
    // Native usage states select the generated SVG background.
    "states": {
      "gauge0": 0, "gauge5": 5, "gauge10": 10, "gauge15": 15,
      "gauge20": 20, "gauge25": 25, "gauge30": 30, "gauge35": 35,
      "gauge40": 40, "gauge45": 45, "gauge50": 50, "gauge55": 55,
      "gauge60": 60, "gauge65": 65, "gauge70": 70, "gauge75": 75,
      "gauge80": 80, "gauge85": 85, "gauge90": 90, "gauge95": 95,
      "gauge100": 100
    }
  },
  "memory": {
    "format": "",
    "format-alt": "<span font_family='DejaVu Sans' weight='normal' size='small'>{percentage}</span>",
    "format-alt-click": 1,
    "interval": 2,
    "tooltip-format": "Memory: {percentage}%\n{used:.1f} / {total:.1f} GiB used\n{avail:.1f} GiB available\nSwap: {swapUsed:.1f} / {swapTotal:.1f} GiB\nClick to toggle icon / usage",
    "states": {
      "gauge0": 0, "gauge5": 5, "gauge10": 10, "gauge15": 15,
      "gauge20": 20, "gauge25": 25, "gauge30": 30, "gauge35": 35,
      "gauge40": 40, "gauge45": 45, "gauge50": 50, "gauge55": 55,
      "gauge60": 60, "gauge65": 65, "gauge70": 70, "gauge75": 75,
      "gauge80": 80, "gauge85": 85, "gauge90": 90, "gauge95": 95,
      "gauge100": 100
    }
  },
  "temperature": {
    // "thermal-zone": 2,
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    // "format-critical": "{temperatureC}°C {icon}",
    "format": "{temperatureC}°C {icon}",
    "format-icons": [
      "",
      "",
      ""
    ]
  },
  "backlight": {
    // "device": "acpi_video1",
    "format": "{percent}% {icon}",
    "format-icons": [
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      "",
      ""
    ]
  },
  "battery": {
    "group-state": true,
    // Battery states select the first threshold >= capacity (unlike CPU).
    // Each ten-percent bucket uses a matching fill; only 100% looks full.
    "states": {
      "level0": 9, "level10": 19, "level20": 29, "level30": 39,
      "level40": 49, "level50": 59, "level60": 69, "level70": 79,
      "level80": 89, "level90": 99, "level100": 100
    },
    "format": "{capacity}%",
    "format-charging": "{capacity}% <span font_family='Font Awesome 7 Free' weight='heavy' size='small'></span>",
    "format-plugged": "{capacity}% <span font_family='Font Awesome 7 Free' weight='heavy' size='small'></span>",
    "tooltip-format": "Battery: {capacity}% · {timeTo}\nPower: {power:.2f} W\nHealth: {health}% · Cycles: {cycles}\nHold and drag: ↙ Power saver · ↓ Balanced · ↘ Performance",
    "tooltip-format-charging": "Battery: {capacity}% · Charging\n{timeTo}\nPower: {power:.2f} W\nHealth: {health}% · Cycles: {cycles}\nHold and drag: ↙ Power saver · ↓ Balanced · ↘ Performance",
    "tooltip-format-plugged": "Battery: {capacity}% · Plugged in (not charging)\nPower: {power:.2f} W\nHealth: {health}% · Cycles: {cycles}\nHold and drag: ↙ Power saver · ↓ Balanced · ↘ Performance",
    "menu": "on-click",
    "menu-anchor": "group-bottom",
    "menu-file": "$HOME/.config/waybar/power_profiles_menu.xml",
    "menu-actions": {
      "power-saver": "powerprofilesctl set power-saver",
      "balanced": "powerprofilesctl set balanced",
      "performance": "powerprofilesctl set performance"
    },
    "interval": 3
  },
  "power-profiles-daemon": {
    "group-state": true,
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nHold and drag: ↙ Power saver · ↓ Balanced · ↘ Performance",
    "tooltip": true,
    "menu": "on-click",
    "menu-anchor": "group-bottom",
    "menu-file": "$HOME/.config/waybar/power_profiles_menu.xml",
    "menu-actions": {
      "power-saver": "powerprofilesctl set power-saver",
      "balanced": "powerprofilesctl set balanced",
      "performance": "powerprofilesctl set performance"
    },
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },
  "network": {
    // Follow Wi-Fi even while a VPN owns the default route.
    "interface": "wl*",
    "interval": 5,
    "format-wifi": "{essid}",
    "format-ethernet": "{ipaddr}/{cidr} ",
    "tooltip-format": "{ifname}\nAddress: {ipaddr}/{cidr}\nGateway: {gwaddr}",
    "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}% ({signaldBm} dBm) · {frequency} GHz\nInterface: {ifname}\nAddress: {ipaddr}/{cidr}\nGateway: {gwaddr}\n↓ {bandwidthDownBits}  ↑ {bandwidthUpBits}\nClick to connect or configure networks",
    "tooltip-format-disconnected": "Wi-Fi disconnected · Click to connect",
    "tooltip-format-disabled": "Wi-Fi disabled · Click to enable Wi-Fi",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "Wi-Fi disconnected ⚠",
    "format-disabled": "Wi-Fi off",
    "on-click": "/run/current-system/sw/bin/nm-sidebar --toggle"
  },
  "network#signal": {
    "interface": "wl*",
    "interval": 5,
    // A nonempty label keeps the SVG icon's tooltip and click target active.
    "format": "\u00a0",
    "format-ethernet": "",
    // Native signal states light the dot, then each separate curved bar.
    "states": {
      "signal0": 0, "signal25": 25, "signal50": 50, "signal75": 75
    },
    "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}% ({signaldBm} dBm) · {frequency} GHz\nClick to connect or configure networks",
    "tooltip-format-linked": "Connected to Wi-Fi, waiting for an IP address",
    "tooltip-format-disconnected": "Wi-Fi disconnected · Click to connect",
    "tooltip-format-disabled": "Wi-Fi disabled · Click to enable Wi-Fi",
    "on-click": "/run/current-system/sw/bin/nm-sidebar --toggle"
  },
  "pulseaudio": {
    // "scroll-step": 1, // %, can be a float
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    },
    "on-click": "pavucontrol"
  },
  "custom/media": {
    "format": "{icon} {}",
    "return-type": "json",
    "max-length": 40,
    "format-icons": {
      "spotify": "",
      "default": "🎜"
    },
    "escape": true,
    "exec": "$HOME/.config/waybar/mediaplayer.py 2> /dev/null" // Script in resources folder
    // "exec": "$HOME/.config/waybar/mediaplayer.py --player spotify 2> /dev/null" // Filter player based on name
  },
  "custom/power": {
    "format": "⏻ ",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/power_menu.xml", // Menu file in resources folder
    "menu-actions": {
      "shutdown": "shutdown",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "hibernate": "systemctl hibernate"
    }
  }
}
